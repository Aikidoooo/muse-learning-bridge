# 管理API（/config, /providers/test, /providers/models, /credentials/status）用トークン
# Muse の Secure Credentials Store または安全な環境変数で設定すること
MUSE_BRIDGE_ADMIN_TOKEN=

# 外部AI APIキー設定（実際の値を設定した .env ファイルを作成し、絶対にコミットしないこと）
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1

# サーバー設定オーバーライド（任意）
MUSE_BRIDGE_HOST=127.0.0.1
MUSE_BRIDGE_PORT=8765
MUSE_BRIDGE_LOG_LEVEL=INFO
